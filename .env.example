# 混淆小镇 环境变量（Vercel 项目设置 → Environment Variables 中逐项添加）
# 本地运行种子脚本时：cp .env.example .env 并填入真实值，然后
#   export $(grep -v '^#' .env | xargs) && npm run town:seed

# OpenRouter（必填）— LLM 调用
OPENROUTER_API_KEY=sk-or-v1-xxxx
# 可选：覆盖默认模型 deepseek/deepseek-chat
# OPENROUTER_MODEL=deepseek/deepseek-chat

# Supabase（必填）— 控制台 → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxx

# 可选：站点 URL（用于 OpenRouter 请求头）
# TOWN_SITE_URL=https://你的域名
